{
  "name": "kenzie.ink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "npm run build && git diff --quiet build || (git add build && git commit -m 'update gh-pages') && git subtree push --prefix build origin gh-pages",
    "lint": "eslint src --fix"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://kenzie.ink",
  "dependencies": {
    "dompurify": "^3.0.5",
    "gh-pages": "^5.0.0",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.32.2",
    "sass": "^1.61.0"
  }
}
