{
  "name": "kenzie.ink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "predeploy": "npm run build",
    "deploy": "npm run build && git diff --quiet dist || (git add dist && git commit -m 'update gh-pages') && git subtree push --prefix dist origin gh-pages",
    "lint": "eslint src --fix"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://kenzie.ink",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "dompurify": "^3.0.5",
    "gh-pages": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.32.2",
    "postcss-normalize": "^13.0.1",
    "sass": "^1.61.0"
  }
}
